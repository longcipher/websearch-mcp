    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0",
    "nanoid": "^5.1.7",
    "pino": "^10.3.1",
    "turndown": "^7.2.0",
    "undici": "^8.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "bun-types": "1.3.11",
    "@types/turndown": "^5.0.5"
  }
}
